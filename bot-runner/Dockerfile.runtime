# CI supplies dist compiled and tested in the same workflow run.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
# Install native production dependencies for Alpine; never copy Ubuntu modules.
RUN npm ci --omit=dev && npm cache clean --force
COPY dist dist
USER node
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 CMD ["node", "dist/healthcheck.js"]
CMD ["node", "dist/main.js"]
