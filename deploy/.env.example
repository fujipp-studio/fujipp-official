API_DOMAIN=api.example.com

SUPABASE_URL=
# Optional when the public token issuer differs from the container-reachable URL.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MIN_IDLE=1

APP_CORS_ALLOWED_ORIGINS=https://example.com
STORE_SECRET_KEY_BASE64=
STORE_SECRET_KEY_VERSION=v1
# Generate with: openssl rand -base64 48
RUNNER_API_TOKEN=
# Optional during zero-downtime rotation; remove after every runner uses the new token.
RUNNER_API_PREVIOUS_TOKEN=
TRUEMONEY_USER_AGENT=fujipp-voucher/1.0
TRUEMONEY_TIMEOUT_MS=12000
RUNTIME_POLL_INTERVAL_MS=30000
RUNTIME_BOOTSTRAP_CACHE_TTL=60s
BOT_WORKER_MAX_OLD_SPACE_MB=256

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
